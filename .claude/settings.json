{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node scripts/brand_db.js:*)",
      "Bash(node scripts/migrate_existing_sessions.js:*)",
      "Bash(node scripts/openai_image.js:*)",
      "Bash(node scripts/replicate_image.js:*)",
      "Bash(node scripts/resize.js:*)",
      "Bash(node scripts/upscale.js:*)",
      "Bash(node scripts/remove_bg.js:*)",
      "Bash(node scripts/validate_export.js:*)",
      "Bash(node scripts/sync_vault.js:*)",
      "Bash(python scripts/remove_bg.py:*)",
      "Bash(realesrgan-ncnn-vulkan:*)",
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(node --version)",
      "Bash(node -e:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(rm output/test_brands*)",
      "Bash(git status)",
      "Bash(git log:*)",
      "Bash(git diff:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/sync_vault.js --trigger stop"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/sync_vault.js --trigger session-end"
          }
        ]
      }
    ]
  }
}
