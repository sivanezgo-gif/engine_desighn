# EzGo Banner Generator — environment template
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# OpenAI API (required for background image generation)
OPENAI_API_KEY=sk-...

# OpenAI image model + quality (defaults if omitted: gpt-image-2 / medium)
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium

# Optional: cap on OpenAI calls per session before the orchestrator soft-prompts the user.
# Leave unset to use the default (30).
# OPENAI_CALL_SOFT_CAP=30

# ---------------------------------------------------------------------------
# Phase B — AI tool integrations
# ---------------------------------------------------------------------------

# Figma Personal Access Token — used by the Figma MCP server (see .mcp.json).
# Generate at: Figma → Settings → Security → Personal access tokens.
# IMPORTANT: an MCP server reads this from the *real* environment, NOT from this
# .env file. On Windows: run  setx FIGMA_TOKEN "figd_..."  then RESTART Claude
# Code. (Node scripts do read .env directly; MCP servers do not.)
FIGMA_TOKEN=figd_...

# Replicate API token — multi-model image generation (Flux / Recraft / Ideogram)
# via scripts/replicate_image.js. Get one at https://replicate.com/account/api-tokens
# Until this is set, canva-designer falls back to gpt-image for every direction.
REPLICATE_API_TOKEN=r8_...

# Unsplash Access Key — free stock reference/background search.
# Register an app at https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=...

# ---------------------------------------------------------------------------
# Supabase — cloud brand registry (optional sync alongside local SQLite)
# ---------------------------------------------------------------------------
# Project URL and anon key from: Supabase dashboard → Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Service role key — required for server-side writes (bypass RLS).
# Get from: Supabase dashboard → Settings → API → service_role key
# SUPABASE_SERVICE_KEY=eyJ...

# Postgres connection strings (for direct DB access via ORM / migrations)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"
